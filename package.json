{
  "name": "dsh-chunfeng-image",
  "version": "0.1.0",
  "description": "春风画布：DSH 里的无限画布创作工具，节点式 AI 出图与编排",
  "author": "chunfeng <373119262@qq.com>",
  "homepage": "https://github.com/chunfengbuyu000/dsh-chunfeng-image#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/chunfengbuyu000/dsh-chunfeng-image.git"
  },
  "bugs": {
    "url": "https://github.com/chunfengbuyu000/dsh-chunfeng-image/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "infinite-canvas",
    "ai-image",
    "chunfeng"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node scripts/selftest.mjs && node scripts/history-test.mjs && node scripts/image-ops-test.mjs && node scripts/mask-test.mjs && node scripts/prompt-sources-test.mjs && node scripts/zip-test.mjs && node scripts/video-test.mjs && node scripts/host-test.mjs && node scripts/storage-test.mjs && node scripts/generate-test.mjs && node scripts/e2e.mjs",
    "test:unit": "node scripts/selftest.mjs && node scripts/history-test.mjs && node scripts/image-ops-test.mjs && node scripts/mask-test.mjs && node scripts/prompt-sources-test.mjs && node scripts/zip-test.mjs && node scripts/video-test.mjs && node scripts/host-test.mjs",
    "test:ui": "node scripts/e2e.mjs",
    "test:host": "node scripts/host-test.mjs",
    "test:storage": "node scripts/storage-test.mjs",
    "test:gen": "node scripts/generate-test.mjs",
    "test:history": "node scripts/history-test.mjs",
    "test:perf": "node scripts/perf-test.mjs 500",
    "test:image": "node scripts/image-ops-test.mjs",
    "test:zip": "node scripts/zip-test.mjs",
    "test:prompts": "node scripts/prompt-sources-test.mjs",
    "test:video": "node scripts/video-test.mjs",
    "shot:readme": "node scripts/readme-shots.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
